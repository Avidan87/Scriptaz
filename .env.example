# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default
# Optional AWS Credentials (if not using ~/.aws/credentials or IAM)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Amazon Bedrock Model Configuration
BEDROCK_MODEL_ID=us.deepseek.r1-v1:0
BEDROCK_FALLBACK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# S3 Assets & Dataset Bucket (Optional Cloud Sync)
# S3_BUCKET_NAME=scriptaz-app-data

# Local Application Settings
SCRIPTAZ_DATA_DIR=~/.scriptaz
DEFAULT_INTERVAL_MINUTES=60
DEFAULT_DAILY_LIMIT=5
DEFAULT_BIBLE_VERSION=KJV
DEFAULT_THEME=Sin & Grace
