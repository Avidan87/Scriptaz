# Optional AI features: Scriptaz works locally without these values.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.deepseek.r1-v1:0
BEDROCK_FALLBACK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Maintainer/distribution settings for the versioned shared Scripture data pack.
# Configure these after uploading the release asset; do not commit credentials.
SCRIPTAZ_DATA_PACK_URL=
SCRIPTAZ_DATA_PACK_SHA256=
